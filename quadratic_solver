import math

def discriminant_1(a, b, c):
    return b * b - 4 * a * c

def roots_1(a, b, c):
    d = discriminant_1(a, b, c)
    if d > 0:
        root1 = (-b + math.sqrt(d)) / (2 * a)
        root2 = (-b - math.sqrt(d)) / (2 * a)
        return root1, root2
    elif d == 0:
        root = -b / (2 * a)
        return root, root
    else:
        real_part = -b / (2 * a)
        imaginary_part = math.sqrt(-d) / (2 * abs(a))
        root1 = complex(real_part, imaginary_part)
        root2 = complex(real_part, -imaginary_part)
        return root1, root2

def vertex_1(a, b, c):
    x = -b / (2 * a)
    y = a * x * x + b * x + c
    return x, y
def main():
    print("Quadratic Equation Solver")
    print("This program solves for equations in the form ax^2 + bx + c = 0.")
    try:
        a = float(input("Enter a: "))
        if a == 0:
            print("This is not a quadratic equation because a cannot be 0")
            return
        b = float(input("Enter b: "))
        c = float(input("Enter c: "))
        discriminant = discriminant_1(a, b, c)
        root1, root2 = roots_1(a, b, c)
        vertex_x, vertex_y = vertex_1(a, b, c)
        print()
        print("Results:")
        print("Discriminant:", discriminant)
        if discriminant > 0:
            print("There are two real roots.")
        elif discriminant == 0:
            print("There is one repeated real root.")
        else:
            print("There are two complex roots.")
        print("Root 1:", root1)
        print("Root 2:", root2)
        print("Vertex:", "(", vertex_x, ",", vertex_y, ")")
main()
